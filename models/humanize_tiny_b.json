{
  "encoder_config_path": "models/humanize_encoder.json",
  "n_embd": 256,
  "n_layer": 4,
  "n_head": 4,
  "learning_rate": 0.0003,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "warmup_steps": 1000,
  "lr_scheduler_type": "cosine",
  "max_steps": 200000,
  "per_device_batch_size": 32,
  "gradient_accumulation_steps": 1,
  "seed": 42,
  "num_workers": 8,
  "precision": "bf16",
  "max_seq_len": 2048,
  "save_steps": 2000,
  "eval_steps": 2000,
  "logging_steps": 50,
  "logger": "wandb",
  "wandb_project": "midi-gpt",
  "wandb_entity": "",
  "max_tracks": 12,
  "min_tracks": 1,
  "min_fill_ratio": 0.75,
  "infill_probability": 0.0,
  "infill_bar_fraction": 0.0,
  "humanize_probability": 1.0,
  "humanize_bar_fraction": 0.5,
  "structured_target_probability": 0.4,
  "context_mechanical_fraction": 0.0,
  "mechanical_coherent_targets": false,
  "mechanical_coherent_residual": 0.0,
  "mask_apply_probability": 0.0,
  "mask_mode": 2,
  "mask_bar_fraction": 0.25,
  "mask_max_lookahead": 4,
  "limit_val_batches": 200
}
